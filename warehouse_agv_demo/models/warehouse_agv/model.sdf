    <joint name="s4_right_a_joint" type="revolute"><parent>scissor_stage_4</parent><child>s4_right_a</child><axis><xyz expressed_in="__model__">0 -1 0</xyz><limit><lower>0</lower><upper>1.00</upper><effort>20</effort><velocity>0.50</velocity></limit><dynamics><damping>0.4</damping><friction>0.05</friction></dynamics></axis></joint>
    <joint name="s4_right_b_joint" type="revolute"><parent>scissor_stage_4</parent><child>s4_right_b</child><axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>0</lower><upper>1.00</upper><effort>20</effort><velocity>0.50</velocity></limit><dynamics><damping>0.4</damping><friction>0.05</friction></dynamics></axis></joint>
    <joint name="s5_left_a_joint" type="revolute"><parent>scissor_stage_5</parent><child>s5_left_a</child><axis><xyz expressed_in="__model__">0 -1 0</xyz><limit><lower>0</lower><upper>1.00</upper><effort>20</effort><velocity>0.50</velocity></limit><dynamics><damping>0.4</damping><friction>0.05</friction></dynamics></axis></joint>
    <joint name="s5_left_b_joint" type="revolute"><parent>scissor_stage_5</parent><child>s5_left_b</child><axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>0</lower><upper>1.00</upper><effort>20</effort><velocity>0.50</velocity></limit><dynamics><damping>0.4</damping><friction>0.05</friction></dynamics></axis></joint>
    <joint name="s5_right_a_joint" type="revolute"><parent>scissor_stage_5</parent><child>s5_right_a</child><axis><xyz expressed_in="__model__">0 -1 0</xyz><limit><lower>0</lower><upper>1.00</upper><effort>20</effort><velocity>0.50</velocity></limit><dynamics><damping>0.4</damping><friction>0.05</friction></dynamics></axis></joint>
    <joint name="s5_right_b_joint" type="revolute"><parent>scissor_stage_5</parent><child>s5_right_b</child><axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>0</lower><upper>1.00</upper><effort>20</effort><velocity>0.50</velocity></limit><dynamics><damping>0.4</damping><friction>0.05</friction></dynamics></axis></joint>

    <link name="lidar_link">
      <!-- Compact 360-degree scanner above the two rear support plates. -->
      <pose>-0.2063125 0 0.664 0 0 0</pose>
      <gravity>false</gravity>
      <inertial><mass>0.5</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz></inertia></inertial>
      <visual name="wall_lidar"><geometry><cylinder><radius>0.025</radius><length>0.018</length></cylinder></geometry><material><ambient>0.025 0.028 0.034 1</ambient><diffuse>0.06 0.065 0.075 1</diffuse><specular>0.5 0.5 0.5 1</specular></material></visual>
      <sensor name="lidar" type="gpu_lidar">
        <always_on>true</always_on><update_rate>12</update_rate><visualize>true</visualize>
        <topic>/warehouse_agv/scan</topic>
        <lidar>
          <scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
          <range><min>0.04</min><max>12.0</max><resolution>0.01</resolution></range>
        </lidar>
      </sensor>
    </link>
    <joint name="lidar_joint" type="fixed"><parent>fork_carriage</parent><child>lidar_link</child></joint>

    <link name="camera_link">
      <!-- The optical axis is parallel to the floor for visual localization. -->
      <pose>-0.1915625 0 0.640 0 0 0</pose>
      <gravity>false</gravity>
      <inertial><mass>0.075</mass><inertia><ixx>0.00005</ixx><iyy>0.00005</iyy><izz>0.00005</izz></inertia></inertial>
      <!-- Intel RealSense D435 physical envelope: 90 x 25 x 25 mm. The
           camera faces positive X, so depth/width/height map to X/Y/Z. -->
      <visual name="housing"><geometry><box><size>0.025 0.090 0.025</size></box></geometry><material><ambient>0.018 0.020 0.024 1</ambient><diffuse>0.03 0.034 0.04 1</diffuse></material></visual>
      <visual name="depth_lens_left"><pose>0.014 0.028 0 0 1.5708 0</pose><geometry><cylinder><radius>0.006</radius><length>0.004</length></cylinder></geometry><material><ambient>0.01 0.06 0.13 1</ambient><diffuse>0.01 0.10 0.22 1</diffuse><specular>0.9 0.9 1 1</specular></material></visual>
      <visual name="rgb_lens"><pose>0.014 0 0 0 1.5708 0</pose><geometry><cylinder><radius>0.005</radius><length>0.004</length></cylinder></geometry><material><ambient>0.015 0.035 0.055 1</ambient><diffuse>0.02 0.06 0.09 1</diffuse><specular>0.9 0.9 1 1</specular></material></visual>
      <visual name="depth_lens_right"><pose>0.014 -0.028 0 0 1.5708 0</pose><geometry><cylinder><radius>0.006</radius><length>0.004</length></cylinder></geometry><material><ambient>0.01 0.06 0.13 1</ambient><diffuse>0.01 0.10 0.22 1</diffuse><specular>0.9 0.9 1 1</specular></material></visual>
      <visual name="wall_mount"><pose>-0.006 0 -0.0175 0 0 0</pose><geometry><box><size>0.014 0.040 0.020</size></box></geometry><material><ambient>0.10 0.11 0.12 1</ambient><diffuse>0.18 0.19 0.21 1</diffuse></material></visual>
      <sensor name="front_camera" type="camera">
        <always_on>true</always_on><update_rate>32</update_rate><visualize>true</visualize>
        <topic>/warehouse_agv/camera</topic>
        <camera>
          <horizontal_fov>1.22</horizontal_fov>
          <image><width>640</width><height>360</height><format>R8G8B8</format></image>
          <clip><near>0.08</near><far>100</far></clip>
        </camera>
      </sensor>
    </link>
    <joint name="camera_joint" type="fixed"><parent>fork_carriage</parent><child>camera_link</child></joint>

    <!-- Flat lifting platform with no guard rails. -->
    <link name="fork_carriage">
      <pose>0 0 0.363575 0 0 0</pose>
      <gravity>false</gravity>
      <inertial><mass>4</mass><inertia><ixx>0.03</ixx><iyy>0.06</iyy><izz>0.07</izz></inertia></inertial>
      <!-- Matches the full outer bumper bounding box: 0.394625 x 0.30625 m. -->
      <visual name="platform"><geometry><box><size>0.394625 0.30625 0.025</size></box></geometry><material><ambient>0.55 0.014 0.020 1</ambient><diffuse>0.80 0.022 0.030 1</diffuse><specular>0.38 0.38 0.38 1</specular></material></visual>
      <!-- Two fixed flat plates, one behind each suction cup. -->
      <visual name="sensor_plate_left"><pose>-0.2063125 0.055 0.14 0 0 0</pose><geometry><box><size>0.018 0.055 0.28</size></box></geometry><material><ambient>0.55 0.014 0.020 1</ambient><diffuse>0.80 0.022 0.030 1</diffuse><specular>0.35 0.35 0.35 1</specular></material></visual>
      <visual name="sensor_plate_right"><pose>-0.2063125 -0.055 0.14 0 0 0</pose><geometry><box><size>0.018 0.055 0.28</size></box></geometry><material><ambient>0.55 0.014 0.020 1</ambient><diffuse>0.80 0.022 0.030 1</diffuse><specular>0.35 0.35 0.35 1</specular></material></visual>
      <!-- Horizontal cap joins the two plates and physically supports LiDAR. -->
      <visual name="lidar_support_plate"><pose>-0.2063125 0 0.286 0 0 0</pose><geometry><box><size>0.070 0.150 0.012</size></box></geometry><material><ambient>0.08 0.085 0.095 1</ambient><diffuse>0.15 0.16 0.18 1</diffuse><specular>0.45 0.45 0.45 1</specular></material></visual>
      <visual name="undertray_support"><pose>0 0 -0.0225 0 0 0</pose><geometry><box><size>0.342375 0.26625 0.02</size></box></geometry><material><ambient>0.035 0.038 0.045 1</ambient><diffuse>0.07 0.075 0.085 1</diffuse></material></visual>
      <collision name="platform_collision"><geometry><box><size>0.394625 0.30625 0.025</size></box></geometry></collision>
      <collision name="sensor_plate_left_collision"><pose>-0.2063125 0.055 0.14 0 0 0</pose><geometry><box><size>0.018 0.055 0.28</size></box></geometry></collision>
      <collision name="sensor_plate_right_collision"><pose>-0.2063125 -0.055 0.14 0 0 0</pose><geometry><box><size>0.018 0.055 0.28</size></box></geometry></collision>
      <collision name="lidar_support_plate_collision"><pose>-0.2063125 0 0.286 0 0 0</pose><geometry><box><size>0.070 0.150 0.012</size></box></geometry></collision>
    </link>
    <joint name="fork_lift_joint" type="prismatic">
      <parent>base_link</parent><child>fork_carriage</child>
      <axis><xyz>0 0 1</xyz><limit><lower>0</lower><upper>1.0625</upper><effort>500</effort><velocity>0.5625</velocity></limit></axis>
    </joint>
    <link name="fork_reach">
      <!-- Suction assembly is independent from the fixed sensor bracket. -->
      <!-- Retracted T-head sits near the rear edge of the expanded tray. -->
      <pose relative_to="fork_carriage">-0.225 0 0.065 0 0 0</pose>
      <gravity>false</gravity>
      <inertial><mass>2</mass><inertia><ixx>0.015</ixx><iyy>0.035</iyy><izz>0.035</izz></inertia></inertial>
      <!-- The complete twin-cup head is one moving carriage. Its prismatic
           guide and actuator are hidden below the platform surface. -->
      <!-- Inverted-L carriage. Its vertical leg is the moving slider; the
           horizontal leg is concealed inside / below the platform so the
           cargo surface remains completely flat. -->
      <visual name="inverted_l_slider"><pose>0 0 -0.083 0 0 0</pose><geometry><box><size>0.024 0.034 0.050</size></box></geometry><material><ambient>0.42 0.010 0.015 1</ambient><diffuse>0.66 0.016 0.023 1</diffuse><specular>0.30 0.30 0.30 1</specular></material></visual>
      <visual name="inverted_l_horizontal"><pose>0.040 0 -0.064 0 0 0</pose><geometry><box><size>0.080 0.030 0.014</size></box></geometry><material><ambient>0.50 0.012 0.018 1</ambient><diffuse>0.74 0.018 0.026 1</diffuse><specular>0.30 0.30 0.30 1</specular></material></visual>
      <!-- The foot of the open T-head is fixed to the forward end of the
           inverted-L horizontal leg. Only this narrow T rises above the tray. -->
      <visual name="suction_t_upright"><pose>0.080 0 0 0 0 0</pose><geometry><box><size>0.024 0.035 0.110</size></box></geometry><material><ambient>0.55 0.014 0.020 1</ambient><diffuse>0.80 0.022 0.030 1</diffuse><specular>0.35 0.35 0.35 1</specular></material></visual>
      <visual name="suction_t_crossbar"><pose>0.080 0 0.0375 0 0 0</pose><geometry><box><size>0.024 0.145 0.035</size></box></geometry><material><ambient>0.55 0.014 0.020 1</ambient><diffuse>0.80 0.022 0.030 1</diffuse><specular>0.35 0.35 0.35 1</specular></material></visual>
      <!-- Compact suction heads: the large grey cylinders were visually
           misleading.  Each head now has only a short metal stem followed by
           a shallow rubber pad, like the side profile of the real mechanism. -->
      <visual name="suction_stem_left"><pose>0.096 0.050 0.0375 0 1.5708 0</pose><geometry><cylinder><radius>0.006</radius><length>0.008</length></cylinder></geometry><material><ambient>0.18 0.19 0.21 1</ambient><diffuse>0.32 0.34 0.37 1</diffuse><specular>0.65 0.65 0.65 1</specular></material></visual>
      <visual name="suction_stem_right"><pose>0.096 -0.050 0.0375 0 1.5708 0</pose><geometry><cylinder><radius>0.006</radius><length>0.008</length></cylinder></geometry><material><ambient>0.18 0.19 0.21 1</ambient><diffuse>0.32 0.34 0.37 1</diffuse><specular>0.65 0.65 0.65 1</specular></material></visual>
      <visual name="suction_cup_left"><pose>0.105 0.050 0.0375 0 1.5708 0</pose><geometry><cylinder><radius>0.014</radius><length>0.010</length></cylinder></geometry><material><ambient>0.008 0.008 0.010 1</ambient><diffuse>0.018 0.018 0.022 1</diffuse></material></visual>
      <visual name="suction_cup_right"><pose>0.105 -0.050 0.0375 0 1.5708 0</pose><geometry><cylinder><radius>0.014</radius><length>0.010</length></cylinder></geometry><material><ambient>0.008 0.008 0.010 1</ambient><diffuse>0.018 0.018 0.022 1</diffuse></material></visual>
      <visual name="suction_lip_left"><pose>0.112 0.050 0.0375 0 1.5708 0</pose><geometry><cylinder><radius>0.0165</radius><length>0.004</length></cylinder></geometry><material><ambient>0.004 0.004 0.005 1</ambient><diffuse>0.010 0.010 0.012 1</diffuse></material></visual>
      <visual name="suction_lip_right"><pose>0.112 -0.050 0.0375 0 1.5708 0</pose><geometry><cylinder><radius>0.0165</radius><length>0.004</length></cylinder></geometry><material><ambient>0.004 0.004 0.005 1</ambient><diffuse>0.010 0.010 0.012 1</diffuse></material></visual>
      <collision name="inverted_l_slider_collision"><pose>0 0 -0.083 0 0 0</pose><geometry><box><size>0.024 0.034 0.050</size></box></geometry></collision>
      <collision name="inverted_l_horizontal_collision"><pose>0.040 0 -0.064 0 0 0</pose><geometry><box><size>0.080 0.030 0.014</size></box></geometry></collision>
      <collision name="suction_t_upright_collision"><pose>0.080 0 0 0 0 0</pose><geometry><box><size>0.024 0.035 0.110</size></box></geometry></collision>
      <collision name="suction_t_crossbar_collision"><pose>0.080 0 0.0375 0 0 0</pose><geometry><box><size>0.024 0.145 0.035</size></box></geometry></collision>
    </link>
    <joint name="fork_reach_joint" type="prismatic">
      <parent>fork_carriage</parent><child>fork_reach</child>
      <!-- The visible suction head is compact; the extra reach is provided by
           the concealed linear guide below the tray. -->
      <axis><xyz>1 0 0</xyz><limit><lower>0</lower><upper>0.36125</upper><effort>180</effort><velocity>0.40</velocity></limit></axis>
    </joint>

    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_front_left_joint</left_joint>
      <left_joint>wheel_rear_left_joint</left_joint>
      <right_joint>wheel_front_right_joint</right_joint>
      <right_joint>wheel_rear_right_joint</right_joint>
      <wheel_separation>0.2125</wheel_separation><wheel_radius>0.0375</wheel_radius>
      <topic>/model/warehouse_agv/cmd_vel</topic>
      <odom_topic>/model/warehouse_agv/odometry</odom_topic>
      <tf_topic>/model/warehouse_agv/tf</tf_topic>
      <odom_publish_frequency>30</odom_publish_frequency>
      <frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id>
      <max_linear_acceleration>3.0</max_linear_acceleration><min_linear_acceleration>-3.0</min_linear_acceleration>
      <max_angular_acceleration>4.0</max_angular_acceleration><min_angular_acceleration>-4.0</min_angular_acceleration>
      <max_linear_velocity>1.5</max_linear_velocity><min_linear_velocity>-0.8</min_linear_velocity>
      <max_angular_velocity>1.8</max_angular_velocity><min_angular_velocity>-1.8</min_angular_velocity>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>fork_lift_joint</joint_name>
      <topic>/model/warehouse_agv/joint/fork_platform_joint/cmd_pos</topic>
      <p_gain>2200</p_gain><i_gain>25</i_gain><d_gain>120</d_gain>
      <initial_position>0</initial_position>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>scissor_stage_1_joint</joint_name><topic>/model/warehouse_agv/joint/scissor_stage_1/cmd_pos</topic><p_gain>900</p_gain><d_gain>55</d_gain><initial_position>0</initial_position></plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>scissor_stage_2_joint</joint_name><topic>/model/warehouse_agv/joint/scissor_stage_2/cmd_pos</topic><p_gain>900</p_gain><d_gain>55</d_gain><initial_position>0</initial_position></plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>scissor_stage_3_joint</joint_name><topic>/model/warehouse_agv/joint/scissor_stage_3/cmd_pos</topic><p_gain>900</p_gain><d_gain>55</d_gain><initial_position>0</initial_position></plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>scissor_stage_4_joint</joint_name><topic>/model/warehouse_agv/joint/scissor_stage_4/cmd_pos</topic><p_gain>900</p_gain><d_gain>55</d_gain><initial_position>0</initial_position></plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>scissor_stage_5_joint</joint_name><topic>/model/warehouse_agv/joint/scissor_stage_5/cmd_pos</topic><p_gain>900</p_gain><d_gain>55</d_gain><initial_position>0</initial_position></plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>bottom_slider_left_joint</joint_name><topic>/model/warehouse_agv/joint/scissor_bottom_slider/cmd_pos</topic><p_gain>500</p_gain><d_gain>35</d_gain><initial_position>0</initial_position></plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>bottom_slider_right_joint</joint_name><topic>/model/warehouse_agv/joint/scissor_bottom_slider/cmd_pos</topic><p_gain>500</p_gain><d_gain>35</d_gain><initial_position>0</initial_position></plugin>
<plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>s1_left_a_joint</joint_name><topic>/model/warehouse_agv/joint/scissor_angle/cmd_pos</topic><p_gain>500</p_gain><i_gain>15</i_gain><d_gain>35</d_gain><initial_position>0</initial_position></plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>s1_left_b_joint</joint_name><topic>/model/warehouse_agv/joint/scissor_angle/cmd_pos</topic><p_gain>500</p_gain><i_gain>15</i_gain><d_gain>35</d_gain><initial_position>0</initial_position></plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>s1_right_a_joint</joint_name><topic>/model/warehouse_agv/joint/scissor_angle/cmd_pos</topic><p_gain>500</p_gain><i_gain>15</i_gain><d_gain>35</d_gain><initial_position>0</initial_position></plugin>
