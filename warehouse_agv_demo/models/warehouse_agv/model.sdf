<?xml version="1.0"?>
<sdf version="1.9">
  <model name="warehouse_agv">
    <link name="base_link">
      <pose>0 0 0.16406 0 0 0</pose>
      <inertial>
        <mass>24.7</mass>
        <inertia>
          <ixx>0.412</ixx><iyy>0.815</iyy><izz>1.118</izz>
        </inertia>
      </inertial>
      <collision name="chassis_collision">
        <pose>0 0 -0.0175 0 0 0</pose>
        <geometry><box><size>0.34375 0.2625 0.153125</size></box></geometry>
        <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
      </collision>

      <!-- Smooth one-piece inVia-style body. This mesh contains a genuine
           deep open-top cavity instead of overlapping primitive boxes. -->
      <visual name="invia_body_shell">
        <geometry><mesh><uri>model://warehouse_agv/meshes/invia_body.dae</uri><scale>1.375 1.25 0.875</scale></mesh></geometry>
        <material>
          <ambient>0.030 0.034 0.040 1</ambient>
          <diffuse>0.060 0.067 0.078 1</diffuse>
          <specular>0.42 0.42 0.45 1</specular>
        </material>
      </visual>
      <visual name="thin_black_bumper">
        <geometry><mesh><uri>model://warehouse_agv/meshes/invia_bumper.dae</uri><scale>1.375 1.25 0.875</scale></mesh></geometry>
        <material>
          <ambient>0.008 0.009 0.011 1</ambient>
          <diffuse>0.014 0.016 0.020 1</diffuse>
          <specular>0.24 0.24 0.26 1</specular>
        </material>
      </visual>
      <!-- Compact slash emblem instead of the old rectangular side plate. -->
      <visual name="logo_left_white_a">
        <pose>-0.11 0.15125 0.02625 0 0.22 0</pose><geometry><box><size>0.01375 0.005 0.04375</size></box></geometry>
        <material><ambient>0.88 0.88 0.88 1</ambient><diffuse>0.96 0.96 0.96 1</diffuse></material>
      </visual>
      <visual name="logo_left_white_b">
        <pose>-0.0825 0.15125 0.02625 0 -0.22 0</pose><geometry><box><size>0.01375 0.005 0.04375</size></box></geometry>
        <material><ambient>0.88 0.88 0.88 1</ambient><diffuse>0.96 0.96 0.96 1</diffuse></material>
      </visual>
      <visual name="logo_left_red">
        <pose>-0.055 0.15125 0.02625 0 0.22 0</pose><geometry><box><size>0.01375 0.005 0.04375</size></box></geometry>
        <material><ambient>0.62 0.018 0.025 1</ambient><diffuse>0.84 0.025 0.035 1</diffuse></material>
      </visual>
      <visual name="logo_right_white_a">
        <pose>-0.11 -0.15125 0.02625 0 0.22 0</pose><geometry><box><size>0.01375 0.005 0.04375</size></box></geometry>
        <material><ambient>0.88 0.88 0.88 1</ambient><diffuse>0.96 0.96 0.96 1</diffuse></material>
      </visual>
      <visual name="logo_right_white_b">
        <pose>-0.0825 -0.15125 0.02625 0 -0.22 0</pose><geometry><box><size>0.01375 0.005 0.04375</size></box></geometry>
        <material><ambient>0.88 0.88 0.88 1</ambient><diffuse>0.96 0.96 0.96 1</diffuse></material>
      </visual>
      <visual name="logo_right_red">
        <pose>-0.055 -0.15125 0.02625 0 0.22 0</pose><geometry><box><size>0.01375 0.005 0.04375</size></box></geometry>
        <material><ambient>0.62 0.018 0.025 1</ambient><diffuse>0.84 0.025 0.035 1</diffuse></material>
      </visual>
      <visual name="red_side_accents">
        <geometry><mesh><uri>model://warehouse_agv/meshes/invia_red_stripe.dae</uri><scale>1.375 1.25 0.875</scale></mesh></geometry>
      </visual>

      <!-- Horizontal guide slots for the two bottom scissor pivots. -->
      <visual name="lower_scissor_frame">
        <pose>0 0 -0.08306 0 0 0</pose>
        <geometry><box><size>0.275 0.2125 0.025</size></box></geometry>
        <material><ambient>0.025 0.028 0.033 1</ambient><diffuse>0.055 0.060 0.070 1</diffuse><specular>0.4 0.4 0.4 1</specular></material>
      </visual>
      <visual name="scissor_rail_left">
        <pose>0 0.08125 -0.07706 0 0 0</pose>
        <geometry><box><size>0.275 0.03125 0.015</size></box></geometry>
        <material><ambient>0.025 0.028 0.033 1</ambient><diffuse>0.05 0.055 0.065 1</diffuse><specular>0.35 0.35 0.35 1</specular></material>
      </visual>
      <visual name="scissor_rail_right">
        <pose>0 -0.08125 -0.07706 0 0 0</pose>
        <geometry><box><size>0.275 0.03125 0.015</size></box></geometry>
        <material><ambient>0.025 0.028 0.033 1</ambient><diffuse>0.05 0.055 0.065 1</diffuse><specular>0.35 0.35 0.35 1</specular></material>
      </visual>

      <!-- Fixed yokes connect the four compact wheels to the lower shell. -->
      <visual name="wheel_yoke_front_left">
        <pose>0.116875 0.10625 -0.098 0 0 0</pose><geometry><box><size>0.048125 0.04 0.03125</size></box></geometry>
        <material><ambient>0.055 0.058 0.065 1</ambient><diffuse>0.105 0.110 0.120 1</diffuse><specular>0.35 0.35 0.35 1</specular></material>
      </visual>
      <visual name="wheel_yoke_front_right">
        <pose>0.116875 -0.10625 -0.098 0 0 0</pose><geometry><box><size>0.048125 0.04 0.03125</size></box></geometry>
        <material><ambient>0.055 0.058 0.065 1</ambient><diffuse>0.105 0.110 0.120 1</diffuse><specular>0.35 0.35 0.35 1</specular></material>
      </visual>
      <visual name="wheel_yoke_rear_left">
        <pose>-0.116875 0.10625 -0.098 0 0 0</pose><geometry><box><size>0.048125 0.04 0.03125</size></box></geometry>
        <material><ambient>0.055 0.058 0.065 1</ambient><diffuse>0.105 0.110 0.120 1</diffuse><specular>0.35 0.35 0.35 1</specular></material>
      </visual>
      <visual name="wheel_yoke_rear_right">
        <pose>-0.116875 -0.10625 -0.098 0 0 0</pose><geometry><box><size>0.048125 0.04 0.03125</size></box></geometry>
        <material><ambient>0.055 0.058 0.065 1</ambient><diffuse>0.105 0.110 0.120 1</diffuse><specular>0.35 0.35 0.35 1</specular></material>
      </visual>

      <sensor name="imu" type="imu">
        <always_on>true</always_on><update_rate>50</update_rate>
        <topic>/warehouse_agv/imu</topic>
      </sensor>
    </link>

    <!-- Four small underbody wheels replace the old exposed wheel pair. -->
    <link name="wheel_front_left">
      <pose>0.116875 0.10625 0.0375 1.5708 0 0</pose>
      <inertial><mass>0.75</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.001</izz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.0375</radius><length>0.03</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>0.25</mu2><fdir1>1 0 0</fdir1><slip1>0.01</slip1><slip2>0.04</slip2></ode></friction></surface></collision>
      <visual name="tire"><geometry><cylinder><radius>0.0375</radius><length>0.03</length></cylinder></geometry><material><ambient>0.010 0.010 0.012 1</ambient><diffuse>0.022 0.022 0.026 1</diffuse></material></visual>
      <visual name="hub"><pose>0 0 0.01625 0 0 0</pose><geometry><cylinder><radius>0.0125</radius><length>0.005</length></cylinder></geometry><material><ambient>0.18 0.19 0.21 1</ambient><diffuse>0.32 0.33 0.36 1</diffuse></material></visual>
    </link>
    <link name="wheel_front_right">
      <pose>0.116875 -0.10625 0.0375 1.5708 0 0</pose>
      <inertial><mass>0.75</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.001</izz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.0375</radius><length>0.03</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>0.25</mu2><fdir1>1 0 0</fdir1><slip1>0.01</slip1><slip2>0.04</slip2></ode></friction></surface></collision>
      <visual name="tire"><geometry><cylinder><radius>0.0375</radius><length>0.03</length></cylinder></geometry><material><ambient>0.010 0.010 0.012 1</ambient><diffuse>0.022 0.022 0.026 1</diffuse></material></visual>
      <visual name="hub"><pose>0 0 -0.01625 0 0 0</pose><geometry><cylinder><radius>0.0125</radius><length>0.005</length></cylinder></geometry><material><ambient>0.18 0.19 0.21 1</ambient><diffuse>0.32 0.33 0.36 1</diffuse></material></visual>
    </link>
    <joint name="wheel_front_left_joint" type="revolute">
      <parent>base_link</parent><child>wheel_front_left</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz><limit><effort>80</effort><velocity>40</velocity></limit><dynamics><damping>0.12</damping><friction>0.02</friction></dynamics></axis>
    </joint>
    <joint name="wheel_front_right_joint" type="revolute">
      <parent>base_link</parent><child>wheel_front_right</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz><limit><effort>80</effort><velocity>40</velocity></limit><dynamics><damping>0.12</damping><friction>0.02</friction></dynamics></axis>
    </joint>

    <link name="wheel_rear_left">
      <pose>-0.116875 0.10625 0.0375 1.5708 0 0</pose>
      <inertial><mass>0.75</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.001</izz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.0375</radius><length>0.03</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>0.25</mu2><fdir1>1 0 0</fdir1><slip1>0.01</slip1><slip2>0.04</slip2></ode></friction></surface></collision>
      <visual name="tire"><geometry><cylinder><radius>0.0375</radius><length>0.03</length></cylinder></geometry><material><ambient>0.010 0.010 0.012 1</ambient><diffuse>0.022 0.022 0.026 1</diffuse></material></visual>
      <visual name="hub"><pose>0 0 0.01625 0 0 0</pose><geometry><cylinder><radius>0.0125</radius><length>0.005</length></cylinder></geometry><material><ambient>0.18 0.19 0.21 1</ambient><diffuse>0.32 0.33 0.36 1</diffuse></material></visual>
    </link>
    <link name="wheel_rear_right">
      <pose>-0.116875 -0.10625 0.0375 1.5708 0 0</pose>
      <inertial><mass>0.75</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.001</izz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.0375</radius><length>0.03</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>0.25</mu2><fdir1>1 0 0</fdir1><slip1>0.01</slip1><slip2>0.04</slip2></ode></friction></surface></collision>
      <visual name="tire"><geometry><cylinder><radius>0.0375</radius><length>0.03</length></cylinder></geometry><material><ambient>0.010 0.010 0.012 1</ambient><diffuse>0.022 0.022 0.026 1</diffuse></material></visual>
      <visual name="hub"><pose>0 0 -0.01625 0 0 0</pose><geometry><cylinder><radius>0.0125</radius><length>0.005</length></cylinder></geometry><material><ambient>0.18 0.19 0.21 1</ambient><diffuse>0.32 0.33 0.36 1</diffuse></material></visual>
    </link>
    <joint name="wheel_rear_left_joint" type="revolute"><parent>base_link</parent><child>wheel_rear_left</child><axis><xyz expressed_in="__model__">0 1 0</xyz><limit><effort>80</effort><velocity>40</velocity></limit><dynamics><damping>0.12</damping><friction>0.02</friction></dynamics></axis></joint>
    <joint name="wheel_rear_right_joint" type="revolute"><parent>base_link</parent><child>wheel_rear_right</child><axis><xyz expressed_in="__model__">0 1 0</xyz><limit><effort>80</effort><velocity>40</velocity></limit><dynamics><damping>0.12</damping><friction>0.02</friction></dynamics></axis></joint>

    <!-- Five-stage functional scissor lift. Its first feet are 10 mm above
         the wheel tops; 80% of the folded pack sits inside the low shell. -->
    <link name="scissor_stage_1"><pose>0 0 0.110961 0 0 0</pose><gravity>false</gravity><inertial><mass>0.034</mass><inertia><ixx>0.00017</ixx><iyy>0.00017</iyy><izz>0.00017</izz></inertia></inertial></link>
    <link name="scissor_stage_2"><pose>0 0 0.162882 0 0 0</pose><gravity>false</gravity><inertial><mass>0.034</mass><inertia><ixx>0.00017</ixx><iyy>0.00017</iyy><izz>0.00017</izz></inertia></inertial></link>
    <link name="scissor_stage_3"><pose>0 0 0.214803 0 0 0</pose><gravity>false</gravity><inertial><mass>0.034</mass><inertia><ixx>0.00017</ixx><iyy>0.00017</iyy><izz>0.00017</izz></inertia></inertial></link>
    <link name="scissor_stage_4"><pose>0 0 0.266724 0 0 0</pose><gravity>false</gravity><inertial><mass>0.034</mass><inertia><ixx>0.00017</ixx><iyy>0.00017</iyy><izz>0.00017</izz></inertia></inertial></link>
    <link name="scissor_stage_5"><pose>0 0 0.318646 0 0 0</pose><gravity>false</gravity><inertial><mass>0.034</mass><inertia><ixx>0.00017</ixx><iyy>0.00017</iyy><izz>0.00017</izz></inertia></inertial></link>
    <joint name="scissor_stage_1_joint" type="prismatic"><parent>base_link</parent><child>scissor_stage_1</child><axis><xyz>0 0 1</xyz><limit><lower>0</lower><upper>0.12375</upper><effort>80</effort><velocity>0.165</velocity></limit></axis></joint>
    <joint name="scissor_stage_2_joint" type="prismatic"><parent>base_link</parent><child>scissor_stage_2</child><axis><xyz>0 0 1</xyz><limit><lower>0</lower><upper>0.3575</upper><effort>80</effort><velocity>0.34375</velocity></limit></axis></joint>
    <joint name="scissor_stage_3_joint" type="prismatic"><parent>base_link</parent><child>scissor_stage_3</child><axis><xyz>0 0 1</xyz><limit><lower>0</lower><upper>0.59125</upper><effort>80</effort><velocity>0.5775</velocity></limit></axis></joint>
    <joint name="scissor_stage_4_joint" type="prismatic"><parent>base_link</parent><child>scissor_stage_4</child><axis><xyz>0 0 1</xyz><limit><lower>0</lower><upper>0.825</upper><effort>80</effort><velocity>0.7975</velocity></limit></axis></joint>
    <joint name="scissor_stage_5_joint" type="prismatic"><parent>base_link</parent><child>scissor_stage_5</child><axis><xyz>0 0 1</xyz><limit><lower>0</lower><upper>1.05875</upper><effort>80</effort><velocity>1.03125</velocity></limit></axis></joint>

    <!-- The lower pivots visibly slide toward the center. Their commanded
         displacement is derived from a(theta) = L/2 * cos(theta). -->
    <link name="bottom_slider_left">
      <pose>-0.142022 0 0.085 0 0 0</pose><gravity>false</gravity>
      <inertial><mass>0.15</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
      <visual name="axle"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.01625</radius><length>0.2125</length></cylinder></geometry><material><ambient>0.14 0.15 0.17 1</ambient><diffuse>0.26 0.27 0.30 1</diffuse><specular>0.7 0.7 0.7 1</specular></material></visual>
    </link>
    <link name="bottom_slider_right">
      <pose>0.142022 0 0.085 0 0 0</pose><gravity>false</gravity>
      <inertial><mass>0.15</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
      <visual name="axle"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.01625</radius><length>0.2125</length></cylinder></geometry><material><ambient>0.14 0.15 0.17 1</ambient><diffuse>0.26 0.27 0.30 1</diffuse><specular>0.7 0.7 0.7 1</specular></material></visual>
    </link>
    <joint name="bottom_slider_left_joint" type="prismatic"><parent>base_link</parent><child>bottom_slider_left</child><axis><xyz expressed_in="__model__">1 0 0</xyz><limit><lower>0</lower><upper>0.0825</upper><effort>60</effort><velocity>0.0825</velocity></limit></axis></joint>
    <joint name="bottom_slider_right_joint" type="prismatic"><parent>base_link</parent><child>bottom_slider_right</child><axis><xyz expressed_in="__model__">-1 0 0</xyz><limit><lower>0</lower><upper>0.0825</upper><effort>60</effort><velocity>0.0825</velocity></limit></axis></joint>

    <!-- Stage 1: one X is rendered on each side of the mechanism. -->
    <link name="s1_left_a"><pose relative_to="scissor_stage_1">0 0.08125 0 0 -0.180797 0</pose><gravity>false</gravity><inertial><mass>0.12</mass><inertia><ixx>0.001</ixx><iyy>0.004</iyy><izz>0.004</izz></inertia></inertial><visual name="beam"><geometry><box><size>0.28875 0.0275 0.02</size></box></geometry><material><ambient>0.52 0.012 0.018 1</ambient><diffuse>0.80 0.020 0.028 1</diffuse></material></visual><visual name="pivot"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.0325</length></cylinder></geometry><material><ambient>0.14 0.15 0.17 1</ambient><diffuse>0.24 0.25 0.28 1</diffuse><specular>0.65 0.65 0.65 1</specular></material></visual><visual name="end_pin_pos"><pose>0.144375 0 0 0 0 0</pose><geometry><sphere><radius>0.01625</radius></sphere></geometry><material><ambient>0.14 0.15 0.17 1</ambient><diffuse>0.24 0.25 0.28 1</diffuse><specular>0.65 0.65 0.65 1</specular></material></visual><visual name="end_pin_neg"><pose>-0.144375 0 0 0 0 0</pose><geometry><sphere><radius>0.01625</radius></sphere></geometry><material><ambient>0.14 0.15 0.17 1</ambient><diffuse>0.24 0.25 0.28 1</diffuse><specular>0.65 0.65 0.65 1</specular></material></visual></link>
    <link name="s1_left_b"><pose relative_to="scissor_stage_1">0 0.08125 0 0 0.180797 0</pose><gravity>false</gravity><inertial><mass>0.12</mass><inertia><ixx>0.001</ixx><iyy>0.004</iyy><izz>0.004</izz></inertia></inertial><visual name="beam"><geometry><box><size>0.28875 0.0275 0.02</size></box></geometry><material><ambient>0.52 0.012 0.018 1</ambient><diffuse>0.80 0.020 0.028 1</diffuse></material></visual><visual name="end_pin_pos"><pose>0.144375 0 0 0 0 0</pose><geometry><sphere><radius>0.01625</radius></sphere></geometry><material><ambient>0.14 0.15 0.17 1</ambient><diffuse>0.24 0.25 0.28 1</diffuse><specular>0.65 0.65 0.65 1</specular></material></visual><visual name="end_pin_neg"><pose>-0.144375 0 0 0 0 0</pose><geometry><sphere><radius>0.01625</radius></sphere></geometry><material><ambient>0.14 0.15 0.17 1</ambient><diffuse>0.24 0.25 0.28 1</diffuse><specular>0.65 0.65 0.65 1</specular></material></visual></link>
    <link name="s1_right_a"><pose relative_to="scissor_stage_1">0 -0.08125 0 0 -0.180797 0</pose><gravity>false</gravity><inertial><mass>0.12</mass><inertia><ixx>0.001</ixx><iyy>0.004</iyy><izz>0.004</izz></inertia></inertial><visual name="beam"><geometry><box><size>0.28875 0.0275 0.02</size></box></geometry><material><ambient>0.52 0.012 0.018 1</ambient><diffuse>0.80 0.020 0.028 1</diffuse></material></visual><visual name="pivot"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.0325</length></cylinder></geometry><material><ambient>0.14 0.15 0.17 1</ambient><diffuse>0.24 0.25 0.28 1</diffuse><specular>0.65 0.65 0.65 1</specular></material></visual><visual name="end_pin_pos"><pose>0.144375 0 0 0 0 0</pose><geometry><sphere><radius>0.01625</radius></sphere></geometry><material><ambient>0.14 0.15 0.17 1</ambient><diffuse>0.24 0.25 0.28 1</diffuse><specular>0.65 0.65 0.65 1</specular></material></visual><visual name="end_pin_neg"><pose>-0.144375 0 0 0 0 0</pose><geometry><sphere><radius>0.01625</radius></sphere></geometry><material><ambient>0.14 0.15 0.17 1</ambient><diffuse>0.24 0.25 0.28 1</diffuse><specular>0.65 0.65 0.65 1</specular></material></visual></link>
    <link name="s1_right_b"><pose relative_to="scissor_stage_1">0 -0.08125 0 0 0.180797 0</pose><gravity>false</gravity><inertial><mass>0.12</mass><inertia><ixx>0.001</ixx><iyy>0.004</iyy><izz>0.004</izz></inertia></inertial><visual name="beam"><geometry><box><size>0.28875 0.0275 0.02</size></box></geometry><material><ambient>0.52 0.012 0.018 1</ambient><diffuse>0.80 0.020 0.028 1</diffuse></material></visual><visual name="end_pin_pos"><pose>0.144375 0 0 0 0 0</pose><geometry><sphere><radius>0.01625</radius></sphere></geometry><material><ambient>0.14 0.15 0.17 1</ambient><diffuse>0.24 0.25 0.28 1</diffuse><specular>0.65 0.65 0.65 1</specular></material></visual><visual name="end_pin_neg"><pose>-0.144375 0 0 0 0 0</pose><geometry><sphere><radius>0.01625</radius></sphere></geometry><material><ambient>0.14 0.15 0.17 1</ambient><diffuse>0.24 0.25 0.28 1</diffuse><specular>0.65 0.65 0.65 1</specular></material></visual></link>

