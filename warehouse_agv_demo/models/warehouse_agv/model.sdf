    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>s2_left_a_joint</joint_name><topic>/model/warehouse_agv/joint/scissor_angle/cmd_pos</topic><p_gain>500</p_gain><i_gain>15</i_gain><d_gain>35</d_gain><initial_position>0</initial_position></plugin>
