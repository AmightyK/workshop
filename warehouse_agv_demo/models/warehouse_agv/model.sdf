    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <!-- The safety and worker controllers consume the compact scalar Pose
           topic. Keep this contract explicit: PosePublisher otherwise uses a
           Pose_V payload, so their Pose callbacks never receive the AGV pose
           and the fail-safe velocity gate remains permanently closed. -->
      <publish_model_pose>true</publish_model_pose>
      <publish_link_pose>true</publish_link_pose>
      <publish_sensor_pose>true</publish_sensor_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <use_pose_vector_msg>false</use_pose_vector_msg>
      <update_frequency>30</update_frequency>
    </plugin>
  </model>
</sdf>
